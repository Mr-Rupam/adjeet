# Fastest setup: vercel env pull .env.local (requires npx vercel link first)
# Manual setup: copy this file to .env.local and fill in values

MONGODB_URI=               # MongoDB Atlas → Database → Connect → Drivers
RESEND_API_KEY=            # resend.com → API Keys
LEAD_EMAIL_FROM=           # e.g. leads@adjeet.in. Must be a VERIFIED domain in Resend.
                           # Falls back to onboarding@resend.dev, Resend's sandbox sender,
                           # which only delivers to the Resend account owner.
LEAD_EMAIL_TO=             # where lead notifications land. Defaults to ranjitadjeet@gmail.com
GOOGLE_PRIVATE_KEY=        # Google Cloud → Service Accounts → JSON key (replace \n with \\n)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SHEET_ID=           # From the Google Sheet URL
GOOGLE_LEADS_WORKSHEET_TITLE= # Optional. Tab that receives enquiries. Leave empty for the first tab, as before.
                           # Needs a Phone header; missing website columns are added after the last header.
UPSTASH_REDIS_REST_URL=    # upstash.com → Redis → REST API
UPSTASH_REDIS_REST_TOKEN=
                           # Enquiries are still stored when Upstash is missing or failing, and the
                           # owner is still notified, but then at most 6 notifications per 10 minutes
                           # per server instance (LEAD_FALLBACK in lib/lead-limits.ts).
LIMITER_KEY_SECRET=        # Optional. Secret for the HMAC that turns addresses and phone numbers into
                           # rate-limit keys. Falls back to TURNSTILE_SECRET_KEY; with neither (local
                           # development) keys are plain SHA-256 hashes. Changing it resets the counts.
LEAD_DAILY_CAP=            # Optional. Enquiries across the whole site per UTC day before notifications stop. Defaults to 300.
LEAD_NOTIFY_HOURLY_CAP=    # Optional. Owner notifications per hour, any phone number. Defaults to 20.
LEAD_NOTIFY_DAILY_CAP=     # Optional. Owner notifications per UTC day, any phone number. Defaults to 60.
                           # Past any cap the enquiry is still stored and receipted; only the notification is skipped.
OPENAI_API_KEY=            # platform.openai.com → API Keys. Also set a hard monthly spend limit there.
CHATBOT_DAILY_BUDGET=      # Optional. Chat replies across all visitors per UTC day. Defaults to 200.
                           # The chat needs Upstash: without it, or if it fails, the chat declines and points to WhatsApp.
CHATBOT_ENABLED=           # Optional. Set to false to switch the chat off: it answers with the WhatsApp message and calls nothing.
CHATBOT_MODEL=             # Optional. OpenAI model for chat replies. Defaults to gpt-3.5-turbo.
TURNSTILE_SECRET_KEY=      # Cloudflare → Turnstile (leave empty to use dev test key)
NEXT_PUBLIC_TURNSTILE_SITE_KEY= # Cloudflare → Turnstile → Site key (public)
TWILIO_ACCOUNT_SID=        # twilio.com → Console Dashboard
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=      # e.g. whatsapp:+14155238886
RUPAM_WHATSAPP_NUMBER=     # e.g. whatsapp:+91XXXXXXXXXX
